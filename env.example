# Registry download tracking
JOYCO_WORKER_SECRET=your-secret-here

# Registry main URL
NEXT_PUBLIC_APP_URL=https://hub.joyco.studio

# Cloudflare Browser Rendering (for screenshots)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# Google Gemini free tier (registry assistant demo). Get a key at
# https://aistudio.google.com — read by @ai-sdk/google.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key-here
