      "updated": 1791295685282,
      "created": 1791227846039,
      "link": null,
      "locked": false,
      "text": "By default, chrome won't decode again\nevicted images, even if the image.png\nfile is still in memory",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "By default, chrome won't decode again evicted images, even if the image.png file is still in memory",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "S0rw7qst_S4s06M5npA3f",
      "type": "text",
      "x": 3349.2609353730695,
      "y": 359.198206964363,
      "width": 480.07806423692205,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
